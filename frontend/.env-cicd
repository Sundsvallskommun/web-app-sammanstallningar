# Build-time environment for the Docker image.
# *_PLACEHOLDER values are replaced by entrypoint.sh at container start from the real environment.
# NEXT_PUBLIC_BASE_PATH affects routing at build time and cannot be a placeholder.
NEXT_PUBLIC_APP_NAME=NEXT_PUBLIC_APP_NAME_PLACEHOLDER
NEXT_PUBLIC_DESCRIPTION=NEXT_PUBLIC_DESCRIPTION_PLACEHOLDER
NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL_PLACEHOLDER
DOMAIN_NAME=DOMAIN_NAME_PLACEHOLDER
NEXT_PUBLIC_BASE_PATH=""
HEALTH_AUTH="false"
HEALTH_USERNAME=""
HEALTH_PASSWORD=""
