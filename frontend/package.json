{
  "name": "@sk-web-gui/web-app-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "yarn generate:middleware-envs",
    "dev": "next dev --turbopack",
    "prebuild": "yarn generate:middleware-envs",
    "build": "next build",
    "start": "next start",
    "generate:middleware-envs": "node middleware-envs-generator.mjs",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "next lint --no-cache",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "cypress": "cypress open",
    "test": "jest --watch",
    "test:coverage": "jest --watchAll --coverage",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.2.12",
    "@sk-web-gui/core": "4.6.2",
    "@sk-web-gui/react": "^3.1.3",
    "axios": "1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.4",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^0.537.0",
    "next": "16.2.12",
    "next-i18n-router": "^5.5.8",
    "next-i18next": "^16.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.16",
    "sanitize-html": "^2.18.0",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "underscore.string": "^3.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^30.5.2",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.29",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.10",
    "swagger-typescript-api": "^13.13.0",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "sharp": "^0.35.5",
    "postcss": "^8.5.29"
  }
}
