{
  "name": "@sk-web-gui/web-app-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "yarn generate:middleware-envs",
    "dev": "next dev --turbopack",
    "prebuild": "yarn generate:middleware-envs",
    "build": "next build",
    "start": "next start",
    "generate:middleware-envs": "node middleware-envs-generator.mjs",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "next lint --no-cache",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "cypress": "cypress open",
    "test": "jest --watch",
    "test:coverage": "jest --watchAll --coverage",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/bundle-analyzer": "^16.1.6",
    "@sk-web-gui/core": "4.4.0",
    "@sk-web-gui/react": "^3.0.11",
    "axios": "1.13.6",
    "dayjs": "^1.11.19",
    "i18next": "^25.8.17",
    "i18next-resources-to-backend": "^1.2.1",
    "next": "16.1.6",
    "next-i18n-router": "^5.5.6",
    "next-i18next": "^15.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.5.7",
    "sanitize-html": "^2.17.1",
    "sass": "^1.98.0",
    "sharp": "^0.34.5",
    "underscore.string": "^3.3.6",
    "yup": "^1.7.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "autoprefixer": "^10.4.27",
    "babel-jest": "^30.3.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.11.0",
    "dotenv": "^17.3.1",
    "envalid": "^8.1.1",
    "eslint": "^10.0.3",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.8",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.8.1",
    "swagger-typescript-api": "^13.4.0",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  }
}
